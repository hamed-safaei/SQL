WITH CTE AS (
    -- Anchor: مدیران سطح اول
    SELECT 
        staff_id, 
        first_name, 
        last_name, 
        manager_id, 
        1 AS level,
        CAST(NULL AS VARCHAR(101)) AS manager_name  -- طول دقیق برای جلوگیری از type mismatch
    FROM sales.staffs
    WHERE manager_id IS NULL

    UNION ALL

    -- Recursive: زیردستان
    SELECT 
        s.staff_id,
        s.first_name,
        s.last_name,
        s.manager_id,
        c.level + 1,
        c.first_name + ' ' + c.last_name AS manager_name
    FROM CTE c
    INNER JOIN sales.staffs s ON s.manager_id = c.staff_id
)
SELECT *
FROM CTE
ORDER BY level, manager_id;
